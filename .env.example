MONGO_URI=mongodb://127.0.0.1:27017/safety_detective
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Must match VITE_PROXY_TARGET in frontend/.env for local development.
PORT=5000
NODE_ENV=development
SEED_ON_START=false
ADMIN_EMAIL=admin@safetydetective.com
ADMIN_PASSWORD=replace_with_a_unique_password
# Frontend origin(s) allowed to call the API; comma-separated, no trailing slash.
CORS_ORIGIN=http://localhost:5173
# The frontend is deployed separately, so the backend serves only /api.
SERVE_FRONTEND=false
