MONGO_URI=mongodb://127.0.0.1:27017/safety_detective
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
PORT=5000
NODE_ENV=development
SEED_ON_START=false
ADMIN_EMAIL=admin@safetydetective.com
ADMIN_PASSWORD=replace_with_a_unique_password
# Optional if hosting frontend separately; comma-separated origins, no trailing slash.
CORS_ORIGIN=http://localhost:5173
# Set false when deploying the backend separately from the frontend.
SERVE_FRONTEND=true
